// =============================================================================
// Job: shopnow/2-config-ansible                                      (Sprint 3)
//
// Runs Ravi's Ansible playbook against the CI agent EC2 that Terraform built,
// then proves it worked (tool versions) and that it is idempotent (a second
// run changes nothing). Triggered automatically by 1-infra-terraform after
// apply, so the flow is Terraform -> Ansible -> (optionally) app deploy.
//
// Needs the Jenkins credential 'ci-agent-ssh' (SSH Username with private key,
// user ec2-user) and the Jenkins server's IP in admin_cidrs of envs/dev.
// =============================================================================

pipeline {
    agent any

    parameters {
        string(name: 'PLAYBOOK', defaultValue: 'ansible-Ravi/site.yml',
               description: 'Playbook path in the capstone repo.')
        booleanParam(name: 'CHECK_IDEMPOTENCY', defaultValue: true,
               description: 'Run the playbook a second time and fail if anything changes.')
        booleanParam(name: 'DEPLOY_APP_AFTER', defaultValue: false,
               description: 'Trigger 3-app-cicd when configuration succeeds.')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        AWS_DEFAULT_REGION        = 'ap-south-1'
        AWS_REGION                = 'ap-south-1'
        TF_DIR                    = 'terraform-Sushmita/envs/dev'
        ANSIBLE_HOST_KEY_CHECKING = 'False'   // agent is rebuilt with a new host key every session
        ANSIBLE_FORCE_COLOR       = 'False'
        ANSIBLE_STDOUT_CALLBACK   = 'default'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Preflight') {
            steps {
                sh '''
                    set -e
                    ansible --version | head -1
                    if [ ! -f "$PLAYBOOK" ]; then
                        echo "ERROR: $PLAYBOOK is not in this branch yet (Ravi's Ansible work must be merged first)."
                        exit 1
                    fi
                    ansible-playbook --syntax-check "$PLAYBOOK" -i localhost,
                '''
            }
        }

        stage('Find CI agent') {
            steps {
                dir(env.TF_DIR) {
                    sh 'terraform init -backend-config=backend.hcl -input=false -no-color >/dev/null'
                    script {
                        env.CI_AGENT_IP = sh(returnStdout: true,
                            script: 'terraform output -raw ci_agent_public_ip 2>/dev/null || true').trim()
                    }
                }
                script {
                    if (!env.CI_AGENT_IP || env.CI_AGENT_IP == 'null') {
                        error('No CI agent in Terraform outputs - is create_ci_agent = true and the environment applied?')
                    }
                    echo "CI agent: ${env.CI_AGENT_IP}"
                }
            }
        }

        stage('Build inventory') {
            steps {
                sh '''
                    set -e
                    mkdir -p build
                    # Prefer Ravi's dynamic inventory (aws_ec2 plugin, tag Role=ci_agent);
                    # fall back to a static one generated from the Terraform output.
                    if [ -f ansible-Ravi/inventory/aws_ec2.yml ]; then
                        echo "Using dynamic inventory ansible-Ravi/inventory/aws_ec2.yml"
                        cp ansible-Ravi/inventory/aws_ec2.yml build/aws_ec2.yml
                        echo "build/aws_ec2.yml" > build/inventory_path
                    else
                        echo "Using static inventory from terraform output"
                        printf '[ci_agent]\\n%s ansible_user=ec2-user\\n' "$CI_AGENT_IP" > build/inventory.ini
                        echo "build/inventory.ini" > build/inventory_path
                    fi
                    ansible-inventory -i "$(cat build/inventory_path)" --graph
                    echo "Waiting for SSH on $CI_AGENT_IP ..."
                    timeout 300 bash -c "until (exec 3<>/dev/tcp/$CI_AGENT_IP/22) 2>/dev/null; do sleep 5; done"
                '''
            }
        }

        stage('Run playbook') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ci-agent-ssh',
                                                   keyFileVariable: 'SSH_KEY',
                                                   usernameVariable: 'SSH_USER')]) {
                    sh '''
                        set -e
                        ansible-playbook -i "$(cat build/inventory_path)" "$PLAYBOOK" \
                            --private-key "$SSH_KEY" -u "$SSH_USER" | tee build/run1.log
                    '''
                }
            }
        }

        stage('Verify configuration') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ci-agent-ssh',
                                                   keyFileVariable: 'SSH_KEY',
                                                   usernameVariable: 'SSH_USER')]) {
                    sh '''
                        set -e
                        INV="$(cat build/inventory_path)"
                        for check in "docker --version" "kubectl version --client" "git --version" "aws --version" "systemctl is-active docker"; do
                            echo "--- $check"
                            ansible all -i "$INV" --private-key "$SSH_KEY" -u "$SSH_USER" -m shell -a "$check"
                        done
                    '''
                }
            }
        }

        stage('Idempotency check') {
            when { expression { params.CHECK_IDEMPOTENCY } }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'ci-agent-ssh',
                                                   keyFileVariable: 'SSH_KEY',
                                                   usernameVariable: 'SSH_USER')]) {
                    sh '''
                        set -e
                        ansible-playbook -i "$(cat build/inventory_path)" "$PLAYBOOK" \
                            --private-key "$SSH_KEY" -u "$SSH_USER" | tee build/run2.log
                        if grep -E 'changed=[1-9]' build/run2.log; then
                            echo "WARN: the second run still changed something - the playbook is not fully idempotent."
                            exit 3
                        fi
                        echo "Second run: changed=0 - playbook is idempotent."
                    '''
                }
            }
            post {
                failure { echo 'See build/run2.log for the tasks that changed.' }
            }
        }

        stage('Trigger app deployment') {
            when { expression { params.DEPLOY_APP_AFTER } }
            steps {
                // Not waited on: the app pipeline reports its own result.
                build job: 'shopnow/3-app-cicd', wait: false
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'build/*.log', allowEmptyArchive: true
        }
        failure {
            script { notifyFailure('Ansible configuration') }
        }
    }
}

def notifyFailure(String what) {
    def to = env.NOTIFY_EMAIL
    if (!to) {
        echo 'NOTIFY_EMAIL not set - skipping email notification.'
        return
    }
    try {
        mail to: to,
             subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${what})",
             body: "${what} failed.\n\nConsole: ${env.BUILD_URL}console\n"
    } catch (err) {
        echo "Could not send email: ${err}"
    }
}
